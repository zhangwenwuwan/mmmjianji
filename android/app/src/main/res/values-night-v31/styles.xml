<?xml version="1.0" encoding="utf-8"?>
<!-- 暗色 + Android 12+。为什么单独建一份：Android 的资源匹配里
     night 限定符比 version 更优先，所以「深色 + API31」会落到
     values-night/styles.xml，不会用 values-v31 —— 那样就丢了
     windowSplashScreenBackground / AnimatedIcon 的接管，
     系统又会弹一次「白底 + 应用图标」。 -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/boot_scrim</item>
        <item name="android:navigationBarColor">@color/boot_scrim</item>
        <item name="android:windowSplashScreenBackground">@color/boot_scrim</item>
        <item name="android:windowSplashScreenAnimatedIcon">@null</item>
    </style>
</resources>
